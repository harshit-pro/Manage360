# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Database Configuration
DB_URL=jdbc:postgresql://your-db-host:5432/your-db-name
DB_USER=your-db-user
DB_PASS=your-db-password

# Frontend Configuration
FRONTEND_URL=https://manage360-pearl.vercel.app/
CORS_ALLOWED_ORIGINS=https://manage360-pearl.vercel.app

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRATION_MS=7200000

# Server Configuration
PORT=8080

# For multiple CORS origins (comma-separated):
# CORS_ALLOWED_ORIGINS=https://manage360-pearl.vercel.app,https://another-domain.com

